# Database
DATABASE_URL="postgresql://flightradar:flightradar@localhost:5432/flightradar67"

# Redis
REDIS_URL="redis://localhost:6379"

# Auth.js / NextAuth
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# Optional OAuth (leave blank to disable)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Data source: adsblol | opensky | simulator
# adsblol = live ADS-B from https://api.adsb.lol (default)
DATA_SOURCE=adsblol
SIMULATOR_AIRCRAFT_COUNT=3000

# Optional OpenAI-compatible API for RadarAI (mock responses if unset)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Optional Cesium Ion token (OSM/default imagery works without it)
CESIUM_ION_TOKEN=
NEXT_PUBLIC_CESIUM_ION_TOKEN=

# OpenSky (optional authenticated access)
OPENSKY_USERNAME=
OPENSKY_PASSWORD=
